---
const SB_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const SB_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

const accent = '#8BA99A';
const accentDeep = 'color-mix(in srgb, #8BA99A 55%, #141414)';
const cta = '#25D366';
const ctaDeep = '#1FA855';
const ink = '#141414';
const base = '#F5F0E8';
const borde = '#E4DDD2';

const DIAS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
const MESES = [
  'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
  'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
];

const ESTADOS: Record<string, { label: string; color: string; bg: string }> = {
  pendiente: { label: 'Pendiente', color: '#8a6d1f', bg: '#fdf6e0' },
  confirmada: { label: 'Confirmada', color: '#2f6f4f', bg: '#e6f4ec' },
  completada: { label: 'Completada', color: '#5a5a5a', bg: '#ececec' },
  cancelada: { label: 'Cancelada', color: '#a83f2f', bg: '#fbeae7' },
  no_asistio: { label: 'No asistió', color: '#7a5aa8', bg: '#f1eafa' },
};
---

<div class="fl-panel" data-panel>
  <div class="fl-topbar">
    <div class="fl-brand">
      <span class="fl-dot" style={`background:${accent}`}></span>
      <div>
        <p class="fl-brand-name">Agenda</p>
        <p class="fl-brand-sub">Francy Molano Nails Studio</p>
      </div>
    </div>
    <button type="button" class="fl-icon-btn" data-action="equipo" title="Equipo" hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </button>
    <button type="button" class="fl-icon-btn" data-action="recargar" title="Recargar datos">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
    </button>
    <button type="button" class="fl-icon-btn" data-action="salir" title="Salir">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
    </button>
  </div>

  <div class="fl-nav">
    <button type="button" class="fl-nav-btn" data-action="prev" aria-label="Anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button type="button" class="fl-hoy" data-action="hoy">Hoy</button>
    <div class="fl-nav-mid">
      <p class="fl-periodo" data-periodo>—</p>
      <p class="fl-subperiodo" data-subperiodo>—</p>
    </div>
    <button type="button" class="fl-nav-btn" data-action="next" aria-label="Siguiente">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>

  <div class="fl-views" role="tablist">
    <button type="button" class="fl-view-btn is-active" data-view="dia" role="tab">Día</button>
    <button type="button" class="fl-view-btn" data-view="semana" role="tab">Semana</button>
    <button type="button" class="fl-view-btn" data-view="mes" role="tab">Mes</button>
  </div>

  <div class="fl-chips" data-chips></div>

  <div class="fl-stats" data-stats></div>

  <div class="fl-body" data-body></div>

  <button type="button" class="fl-fab" data-action="nueva" aria-label="Nueva cita">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
  </button>
</div>

<div class="fl-login" data-login hidden>
  <div class="fl-login-card">
    <p class="fl-login-eyebrow">Francy Molano · Agenda del equipo</p>
    <h2 class="fl-login-title">Entrar</h2>
    <label class="fl-lb">Correo</label>
    <input class="fl-in" name="email" type="email" autocomplete="username" placeholder="tu@correo.com" />
    <label class="fl-lb">Contraseña</label>
    <input class="fl-in" name="clave" type="password" autocomplete="current-password" placeholder="••••••••" />
    <p class="fl-login-err" data-login-err hidden></p>
    <button type="button" class="fl-save" data-action="entrar">Entrar</button>
  </div>
</div>

<div class="fl-toast" data-toast hidden></div>

<div class="fl-sheet-backdrop" data-sheet-backdrop hidden></div>

<div class="fl-sheet" data-sheet hidden role="dialog" aria-modal="true" aria-labelledby="fl-sheet-title">
  <div class="fl-sheet-grab"></div>
  <div class="fl-sheet-head">
    <div>
      <p class="fl-sheet-eyebrow" data-sheet-eyebrow>—</p>
      <h2 class="fl-sheet-title" id="fl-sheet-title" data-sheet-title>Detalle</h2>
    </div>
    <button type="button" class="fl-icon-btn" data-action="cerrar-sheet" aria-label="Cerrar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="fl-sheet-body" data-sheet-body></div>
</div>

<script is:inline define:vars={{ accent, accentDeep, cta, ctaDeep, ink, base, borde, DIAS, MESES, ESTADOS, SB_URL, SB_ANON }}>
  (function () {
    const root = document.querySelector('[data-panel]');
    if (!root) return;

    const qs = (s) => root.querySelector(s);
    const qsa = (s) => Array.from(root.querySelectorAll(s));

    const els = {
      periodo: qs('[data-periodo]'),
      subperiodo: qs('[data-subperiodo]'),
      chips: qs('[data-chips]'),
      stats: qs('[data-stats]'),
      body: qs('[data-body]'),
      sheet: document.querySelector('[data-sheet]'),
      sheetBody: document.querySelector('[data-sheet-body]'),
      sheetTitle: document.querySelector('[data-sheet-title]'),
      sheetEyebrow: document.querySelector('[data-sheet-eyebrow]'),
      backdrop: document.querySelector('[data-sheet-backdrop]'),
    };

    const ESTADOS_MAP = ESTADOS;
    const BUFFER_MIN = 10;
    const SES_TOK = 'flws:sb:token';
    const SES_EMAIL = 'flws:sb:email';

    let token = null;
    let perfil = null;

    function sbListo() { return !!SB_URL && !!SB_ANON; }
    function headers(auth) {
      const h = { apikey: SB_ANON, 'Content-Type': 'application/json' };
      if (auth && token) h.Authorization = 'Bearer ' + token;
      return h;
    }
    async function sbGet(tabla, query) {
      const r = await fetch(SB_URL + '/rest/v1/' + tabla + '?' + query, { headers: headers(true) });
      if (!r.ok) throw new Error('Error ' + r.status + ' leyendo datos');
      return r.json();
    }
    async function sbUpsert(tabla, fila) {
      const r = await fetch(SB_URL + '/rest/v1/' + tabla + '?on_conflict=id', {
        method: 'POST',
        headers: Object.assign(headers(true), { Prefer: 'resolution=merge-duplicates' }),
        body: JSON.stringify(fila),
      });
      if (!r.ok) throw new Error('No se pudo guardar (' + r.status + ')');
    }
    async function sbBorrar(tabla, id) {
      const r = await fetch(SB_URL + '/rest/v1/' + tabla + '?id=eq.' + encodeURIComponent(id), {
        method: 'DELETE', headers: headers(true),
      });
      if (!r.ok) throw new Error('No se pudo eliminar (' + r.status + ')');
    }
    function profDesdeFila(f) {
      return {
        id: f.id, nombre: f.nombre, email: f.email || null, foto: f.foto || undefined,
        activo: !!f.activo, es_admin: !!f.es_admin, color: f.color || '#8BA99A',
        horarios: Array.isArray(f.horarios) ? f.horarios : [],
        serviciosIds: f.servicios_ids || [], capacidadDiaria: f.capacidad_diaria || 8,
      };
    }
    function citaDesdeFila(f) {
      return {
        id: f.id, profesionalId: f.profesional_id, servicioId: f.servicio_id || 'manual',
        varianteId: f.variante_id || '', varianteNombre: f.variante_nombre || '',
        clienteNombre: f.cliente_nombre || '', clienteTelefono: f.cliente_telefono || '',
        clienteEmail: f.cliente_email || undefined, notas: f.notas || undefined,
        fecha: String(f.fecha).slice(0, 10), inicio: f.inicio, duracion: f.duracion,
        precio: f.precio || 0, estado: f.estado, creadaEn: f.creada_en, esWalkIn: !!f.es_walkin,
      };
    }
    async function entrar(email, clave) {
      const r = await fetch(SB_URL + '/auth/v1/token?grant_type=password', {
        method: 'POST', headers: headers(false),
        body: JSON.stringify({ email: email.trim(), password: clave }),
      });
      if (!r.ok) throw new Error('Correo o contraseña incorrectos');
      const j = await r.json();
      token = j.access_token;
      try { localStorage.setItem(SES_TOK, token); localStorage.setItem(SES_EMAIL, email.trim()); } catch (e) {}
    }
    function salir() {
      token = null; perfil = null;
      try { localStorage.removeItem(SES_TOK); localStorage.removeItem(SES_EMAIL); } catch (e) {}
    }
    async function cargarPerfil(email) {
      const filas = await sbGet('profesionales', 'select=*&email=eq.' + encodeURIComponent(email));
      const f = filas[0];
      if (!f || !f.activo) return null;
      return profDesdeFila(f);
    }
    async function cargarEquipo() {
      const filas = await sbGet('profesionales', 'select=*&order=created_at.asc');
      profesionales = filas.map(profDesdeFila);
    }
    async function cargarCitas(desde, hasta) {
      const filas = await sbGet('citas', 'select=*&fecha=gte.' + desde + '&fecha=lte.' + hasta + '&order=fecha.asc&order=inicio.asc&limit=1000');
      citas = filas.map(citaDesdeFila);
    }
    async function persistirProfesional(p) {
      await sbUpsert('profesionales', {
        id: p.id, nombre: p.nombre, email: p.email || null, color: p.color, foto: p.foto || null,
        activo: p.activo, es_admin: !!p.es_admin, horarios: p.horarios,
        servicios_ids: p.serviciosIds || [], capacidad_diaria: p.capacidadDiaria || 8,
      });
    }
    async function persistirCita(c) {
      await sbUpsert('citas', {
        id: c.id, profesional_id: c.profesionalId, servicio_id: c.servicioId || 'manual',
        variante_id: c.varianteId || '', variante_nombre: c.varianteNombre || '',
        cliente_nombre: c.clienteNombre, cliente_telefono: c.clienteTelefono || '',
        cliente_email: c.clienteEmail || null, notas: c.notas || null, fecha: c.fecha,
        inicio: c.inicio, duracion: c.duracion, precio: c.precio || 0, estado: c.estado,
        creada_en: c.creadaEn, es_walkin: !!c.esWalkIn,
      });
    }
    function toast(msg) {
      const t = document.querySelector('[data-toast]');
      if (!t) return;
      t.textContent = msg; t.hidden = false;
      clearTimeout(t._h);
      t._h = setTimeout(() => { t.hidden = true; }, 3500);
    }

    let profesionales = [];
    let citas = [];
    let vista = 'dia';
    let filtroPro = 'todos';
    let ancla = new Date();

    // ── utilidades ─────────────────────────────────────────────
    const iso = (d) => {
      const x = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
      return x.toISOString().slice(0, 10);
    };
    const parse = (s) => {
      const [a, m, d] = s.split('-').map(Number);
      return new Date(Date.UTC(a, m - 1, d));
    };
    const addDays = (d, n) => {
      const x = new Date(d.getTime());
      x.setUTCDate(x.getUTCDate() + n);
      return x;
    };
    const hhmm = (m) => String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');
    const fmtFechaLarga = (d) => {
      const s = d.toLocaleDateString('es-CO', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
      return s.charAt(0).toUpperCase() + s.slice(1);
    };
    const money = (n) => '$' + n.toLocaleString('es-CO');
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const OCUPAN = ['pendiente', 'confirmada', 'completada'];
    const servicioTexto = (c) => c.varianteNombre || c.servicioId || 'Servicio';
    const proNombre = (id) => (profesionales.find((p) => p.id === id) || {}).nombre || 'Sin asignar';
    const proColor = (id) => (profesionales.find((p) => p.id === id) || {}).color || '#8BA99A';
    const visible = (c) => filtroPro === 'todos' || c.profesionalId === filtroPro;

    // ── sesión y carga ──────────────────────────────────────────
    function mostrarLogin(msg) {
      root.style.display = 'none';
      const l = document.querySelector('[data-login]');
      l.hidden = false;
      const e = l.querySelector('[data-login-err]');
      if (msg) { e.textContent = msg; e.hidden = false; }
      else e.hidden = true;
    }
    function ocultarLogin() {
      document.querySelector('[data-login]').hidden = true;
      root.style.display = '';
    }
    async function recargar() {
      const r = rango();
      await cargarEquipo();
      await cargarCitas(r.desde, r.hasta);
      pintar();
    }
    async function arrancar(email) {
      perfil = await cargarPerfil(email);
      if (!perfil) return false;
      ocultarLogin();
      if (!perfil.es_admin && perfil.id) filtroPro = perfil.id;
      qs('[data-action="equipo"]').hidden = !perfil.es_admin;
      await recargar();
      return true;
    }
    async function intentarEntrar() {
      const l = document.querySelector('[data-login]');
      const email = l.querySelector('[name="email"]').value || '';
      const clave = l.querySelector('[name="clave"]').value || '';
      const err = l.querySelector('[data-login-err]');
      err.hidden = true;
      try {
        if (!sbListo()) throw new Error('Falta configurar la conexión (avísale a Felipe)');
        if (!email.trim() || !clave) throw new Error('Escribe tu correo y contraseña');
        await entrar(email, clave);
        const ok = await arrancar(email.trim());
        if (!ok) { salir(); throw new Error('Tu cuenta no está activa en el equipo'); }
      } catch (e) { err.textContent = (e && e.message) || 'No se pudo entrar'; err.hidden = false; }
    }
    const HORARIO_BASE = [1, 2, 3, 4, 5, 6].map((d) => ({ dia: d, apertura: 540, cierre: 1080, pausa: { inicio: 750, fin: 840 } }));
    const COLORES = ['#8BA99A', '#25D366', '#E8A090', '#6D5BFF', '#E9B44C', '#4CC9F0'];
    function abrirEquipo() {
      if (!perfil || !perfil.es_admin) return;
      els.sheetEyebrow.textContent = 'Administración';
      els.sheetTitle.textContent = 'Equipo';
      let html = '<div class="fl-form">';
      html += profesionales.map((p) =>
        '<div class="fl-equipo-row" data-eq="' + p.id + '">' +
          '<span class="fl-equipo-dot" style="background:' + esc(p.color) + '"></span>' +
          '<div><div class="fl-equipo-nombre">' + esc(p.nombre) + (p.es_admin ? ' <span class="fl-equipo-tag">admin</span>' : '') + (!p.activo ? ' <span class="fl-equipo-tag off">inactiva</span>' : '') + '</div>' +
          '<div class="fl-equipo-sub">' + esc(p.email || 'sin cuenta') + '</div></div>' +
          '<button type="button" class="fl-equipo-btn" data-eq-editar="' + p.id + '">Editar</button>' +
        '</div>'
      ).join('');
      html += '<button type="button" class="fl-save" data-acc="equipo-nuevo">Agregar profesional</button>';
      html += '</div>';
      els.sheetBody.innerHTML = html;
      els.sheetBody.dataset.cita = '';
      mostrarSheet();
      els.sheetBody.querySelectorAll('[data-eq-editar]').forEach((b) => b.addEventListener('click', () => abrirEditarEquipo(b.dataset.eqEditar)));
    }
    function abrirEditarEquipo(id) {
      const p = profesionales.find((x) => x.id === id);
      const esNuevo = !p;
      const v = p || { id: 'pro-' + Date.now(), nombre: '', email: '', color: COLORES[profesionales.length % COLORES.length], activo: true, es_admin: false, horarios: HORARIO_BASE, serviciosIds: [], capacidadDiaria: 8 };
      els.sheetEyebrow.textContent = 'Administración';
      els.sheetTitle.textContent = esNuevo ? 'Nueva profesional' : 'Editar profesional';
      let html = '<div class="fl-form">';
      html += '<label class="fl-lb">Nombre</label><input class="fl-in" name="eq-nombre" value="' + esc(v.nombre) + '" placeholder="Nombre y apellido" />';
      html += '<label class="fl-lb">Correo de su cuenta (vacío = sin acceso aún)</label><input class="fl-in" name="eq-email" type="email" value="' + esc(v.email || '') + '" placeholder="ella@correo.com" />';
      html += '<label class="fl-lb">Color</label><input class="fl-in" name="eq-color" type="color" value="' + esc(v.color || '#8BA99A') + '" />';
      html += '<label class="fl-check"><input type="checkbox" name="eq-activo"' + (v.activo ? ' checked' : '') + ' /><span>Activa (recibe citas)</span></label>';
      html += '<button type="button" class="fl-save" data-acc="equipo-guardar" data-id="' + v.id + '">Guardar</button>';
      html += '</div>';
      els.sheetBody.innerHTML = html;
      els.sheetBody.dataset.cita = '';
      mostrarSheet();
    }


    // ── rango visible ───────────────────────────────────────────
    function rango() {
      if (vista === 'dia') {
        const f = iso(ancla);
        return { desde: f, hasta: f, dias: [f] };
      }
      if (vista === 'semana') {
        const dow = (parse(iso(ancla)).getUTCDay() + 6) % 7;
        const lunes = addDays(ancla, -dow);
        const dias = [];
        for (let i = 0; i < 7; i++) dias.push(iso(addDays(lunes, i)));
        return { desde: dias[0], hasta: dias[6], dias };
      }
      const y = ancla.getUTCFullYear(), m = ancla.getUTCMonth();
      const primero = new Date(Date.UTC(y, m, 1));
      const lead = (primero.getUTCDay() + 6) % 7;
      const ini = addDays(primero, -lead);
      const dias = [];
      for (let i = 0; i < 42; i++) dias.push(iso(addDays(ini, i)));
      return { desde: dias[0], hasta: dias[41], dias };
    }

    function semanasDelMes(dias) {
      const out = [];
      for (let i = 0; i < dias.length; i += 7) out.push(dias.slice(i, i + 7));
      return out;
    }

    // ── datos calculados ────────────────────────────────────────
    function delRango() {
      const r = rango();
      const todas = citas.filter((c) => c.fecha >= r.desde && c.fecha <= r.hasta && visible(c));
      const relevantes = todas.filter((c) => OCUPAN.indexOf(c.estado) >= 0);
      const proIds = filtroPro === 'todos' ? profesionales.map((p) => p.id) : [filtroPro];
      const capacidad = proIds.reduce((a, id) => a + ((profesionales.find((p) => p.id === id) || {}).capacidadDiaria || 0), 0);
      const conCita = relevantes.filter((c) => !c.esWalkIn).length;
      const ingresos = relevantes.filter((c) => c.estado === 'completada').reduce((a, c) => a + c.precio, 0);
      return {
        r, todas, relevantes, capacidad,
        total: relevantes.length,
        conCita,
        walkIns: relevantes.filter((c) => c.esWalkIn).length,
        canceladas: todas.filter((c) => c.estado === 'cancelada' || c.estado === 'no_asistio').length,
        ocupacion: capacidad ? Math.round((conCita / capacidad) * 100) : 0,
        ingresos,
      };
    }

    // ── pintado: encabezado ─────────────────────────────────────
    function pintarEncabezado() {
      const d = ancla;
      if (vista === 'dia') {
        els.periodo.textContent = fmtFechaLarga(d);
        els.subperiodo.textContent = diaNumero(d) === new Date().getDate() ? 'Hoy' : '';
      } else if (vista === 'semana') {
        const r = rango();
        const a = parse(r.dias[0]), b = parse(r.dias[6]);
        els.periodo.textContent = (MESES[a.getUTCMonth()] || '') + ' — ' + (MESES[b.getUTCMonth()] || '');
        els.subperiodo.textContent = a.getUTCDate() + ' al ' + b.getUTCDate() + ', ' + b.getUTCFullYear();
      } else {
        els.periodo.textContent = (MESES[d.getUTCMonth()] || '');
        els.subperiodo.textContent = String(d.getUTCFullYear());
      }
    }
    const diaNumero = (d) => d.getDate();

    function pintarChips() {
      const tot = citas.filter((c) => OCUPAN.indexOf(c.estado) >= 0).length;
      let html = '<button type="button" class="fl-chip is-active' + (filtroPro === 'todos' ? '' : '') + '" data-pro="todos">Todas <span>' + tot + '</span></button>';
      for (const p of profesionales) {
        const n = citas.filter((c) => c.profesionalId === p.id && OCUPAN.indexOf(c.estado) >= 0).length;
        html += '<button type="button" class="fl-chip' + (filtroPro === p.id ? ' is-active' : '') + '" data-pro="' + p.id + '">' +
          '<i style="background:' + p.color + '"></i>' + esc(p.nombre.split(' ')[0]) +
          (p.activo ? '' : ' <em>inactiva</em>') + ' <span>' + n + '</span></button>';
      }
      els.chips.innerHTML = html;
    }

    function pintarStats(d) {
      const cards = [
        { l: 'Citas', v: d.total, s: d.walkIns + ' walk-in' },
        { l: 'Ocupación', v: d.ocupacion + '%', s: d.conCita + ' de ' + d.capacidad + ' cupos' },
        { l: 'Ingresos', v: money(d.ingresos), s: 'completadas' },
        { l: 'No vinieron', v: d.canceladas, s: 'canceladas o faltaron' },
      ];
      els.stats.innerHTML = cards.map((c) =>
        '<div class="fl-stat"><p class="fl-stat-l">' + c.l + '</p><p class="fl-stat-v">' + c.v + '</p><p class="fl-stat-s">' + esc(c.s) + '</p></div>'
      ).join('');
    }

    // ── pintado: cuerpo ─────────────────────────────────────────
    function tarjetaCita(c) {
      const e = ESTADOS_MAP[c.estado] || ESTADOS_MAP.pendiente;
      const col = proColor(c.profesionalId);
      return '<button type="button" class="fl-card" data-cita="' + c.id + '" style="--col:' + col + '">' +
        '<span class="fl-card-bar"></span>' +
        '<span class="fl-card-hora">' + hhmm(c.inicio) + '</span>' +
        '<span class="fl-card-body">' +
          '<span class="fl-card-cliente">' + esc(c.clienteNombre) + (c.esWalkIn ? ' <em class="fl-walk">walk-in</em>' : '') + '</span>' +
          '<span class="fl-card-serv">' + esc(servicioTexto(c)) + '</span>' +
          '<span class="fl-card-meta">' + proNombre(c.profesionalId).split(' ')[0] + ' · ' + c.duracion + ' min · ' + money(c.precio) + '</span>' +
        '</span>' +
        '<span class="fl-badge" style="color:' + e.color + ';background:' + e.bg + '">' + e.label + '</span>' +
      '</button>';
    }

    function pintarDia(d) {
      const fecha = d.r.desde;
      const items = d.relevantes.filter((c) => c.fecha === fecha).sort((a, b) => a.inicio - b.inicio);
      const canceladas = d.todas.filter((c) => c.fecha === fecha && (c.estado === 'cancelada' || c.estado === 'no_asistio')).sort((a, b) => a.inicio - b.inicio);
      const proIds = (filtroPro === 'todos' ? profesionales : profesionales.filter((p) => p.id === filtroPro));
      let html = '';
      let cursor = null;

      for (const c of items) {
        const fin = c.inicio + c.duracion + BUFFER_MIN;
        if (cursor !== null && c.inicio - cursor >= 30) html += hueco(cursor, c.inicio);
        cursor = Math.max(cursor === null ? fin : cursor, fin);
        html += tarjetaCita(c);
      }

      if (!items.length) {
        html = '<div class="fl-empty"><p class="fl-empty-t">Día libre</p><p class="fl-empty-s">No hay citas para este día.</p></div>';
      }

      if (canceladas.length) {
        html += '<p class="fl-subtle">Canceladas y no asistieron</p>' + canceladas.map(tarjetaCita).join('');
      }

      html += '<div class="fl-foot">' + proIds.map((p) => {
        const n = items.filter((c) => c.profesionalId === p.id && !c.esWalkIn).length;
        const cap = p.capacidadDiaria;
        const pct = cap ? Math.round((n / cap) * 100) : 0;
        return '<div class="fl-cap"><div class="fl-cap-top"><i style="background:' + p.color + '"></i><span>' + esc(p.nombre) + '</span><b>' + n + '/' + cap + '</b></div>' +
          '<div class="fl-bar"><span style="width:' + Math.min(100, pct) + '%;background:' + p.color + '"></span></div></div>';
      }).join('') + '</div>';

      els.body.innerHTML = '<div class="fl-dia">' + html + '</div>';
    }

    function hueco(ini, fin) {
      const h = Math.round((fin - ini) / 6) / 10;
      return '<div class="fl-gap"><span>' + h + ' h libre</span></div>';
    }

    function pintarSemana(d) {
      const semanas = semanasDelMes(d.r.dias);
      const hoyIso = iso(new Date());
      let html = '';
      for (const sem of semanas) {
        html += '<div class="fl-week">';
        for (const f of sem) {
          const items = d.relevantes.filter((c) => c.fecha === f).sort((a, b) => a.inicio - b.inicio);
          const dow = parse(f).getUTCDay();
          const fuera = dow === 0;
          html += '<div class="fl-wcol' + (f === hoyIso ? ' is-today' : '') + (fuera ? ' is-off' : '') + '">' +
            '<p class="fl-wcol-h">' + DIAS[(dow + 6) % 7] + ' <b>' + parse(f).getUTCDate() + '</b></p>' +
            (items.length
              ? items.slice(0, 6).map((c) => {
                  const col = proColor(c.profesionalId);
                  const e = ESTADOS_MAP[c.estado] || ESTADOS_MAP.pendiente;
                  return '<button type="button" class="fl-witem' + (c.estado === 'cancelada' || c.estado === 'no_asistio' ? ' is-dim' : '') + '" data-cita="' + c.id + '" style="--col:' + col + '">' +
                    '<span class="fl-witem-h">' + hhmm(c.inicio) + '</span>' +
                    '<span class="fl-witem-n">' + esc(c.clienteNombre.split(' ')[0]) + '</span>' +
                    '<span class="fl-witem-s">' + esc(c.varianteNombre) + '</span>' +
                    '<i class="fl-witem-d" style="background:' + e.bg + ';color:' + e.color + '">' + e.label.charAt(0) + '</i>' +
                  '</button>';
                }).join('')
              : '<p class="fl-wempty">—</p>') +
            (items.length > 6 ? '<p class="fl-wmore">+' + (items.length - 6) + '</p>' : '') +
          '</div>';
        }
        html += '</div>';
      }
      els.body.innerHTML = html;
    }

    function pintarMes(d) {
      const hoyIso = iso(new Date());
      const semanas = semanasDelMes(d.r.dias);
      let html = '<div class="fl-mhead">' + DIAS.map((x) => '<span>' + x + '</span>').join('') + '</div>';
      for (const sem of semanas) {
        html += '<div class="fl-mrow">';
        for (const f of sem) {
          const del = d.relevantes.filter((c) => c.fecha === f);
          const conCita = del.filter((c) => !c.esWalkIn).length;
          const walk = del.filter((c) => c.esWalkIn).length;
          const fuera = parse(f).getUTCMonth() !== ancla.getUTCMonth();
          html += '<button type="button" class="fl-mcell' + (f === hoyIso ? ' is-today' : '') + (fuera ? ' is-off' : '') + '" data-dia="' + f + '">' +
            '<span class="fl-mcell-d">' + parse(f).getUTCDate() + '</span>' +
            (conCita || walk ? '<span class="fl-mdots">' + professionalDots(del) + (walk ? '<i class="fl-mdot is-walk"></i>' : '') + '</span>' : '') +
            (conCita ? '<span class="fl-mcell-n">' + conCita + '</span>' : '') +
          '</button>';
        }
        html += '</div>';
      }
      els.body.innerHTML = html;
    }

    function professionalDots(del) {
      const ids = [];
      for (const c of del) if (ids.indexOf(c.profesionalId) < 0) ids.push(c.profesionalId);
      return ids.slice(0, 3).map((id) => '<i class="fl-mdot" style="background:' + proColor(id) + '"></i>').join('');
    }

    // ── pintado: hoja de detalle ────────────────────────────────
    function abrirCita(id) {
      const c = citas.find((x) => x.id === id);
      if (!c) return;
      const e = ESTADOS_MAP[c.estado] || ESTADOS_MAP.pendiente;
      els.sheetEyebrow.textContent = fmtFechaLarga(parse(c.fecha)) + ' · ' + hhmm(c.inicio);
      els.sheetTitle.textContent = c.clienteNombre;

      let html = '<div class="fl-dl">' +
        row('Servicio', servicioTexto(c)) +
        row('Duración', c.duracion + ' min') +
        row('Precio', money(c.precio)) +
        row('Profesional', proNombre(c.profesionalId)) +
        row('Teléfono', c.clienteTelefono) +
        row('Estado', e.label) +
      '</div>';

      html += '<p class="fl-sheet-l">Cambiar estado</p><div class="fl-acciones">';
      for (const k of Object.keys(ESTADOS_MAP)) {
        const st = ESTADOS_MAP[k];
        html += '<button type="button" class="fl-acc' + (c.estado === k ? ' is-on' : '') + '" data-estado="' + k + '" style="color:' + st.color + ';background:' + st.bg + ';border-color:' + st.color + '">' + st.label + '</button>';
      }
      html += '</div>';

      html += '<p class="fl-sheet-l">Acciones</p><div class="fl-acciones">' +
        '<a class="fl-acc fl-acc-wa" href="https://wa.me/57' + c.clienteTelefono.replace(/\D/g, '').slice(-10) + '" target="_blank" rel="noopener">WhatsApp</a>' +
        '<button type="button" class="fl-acc" data-acc="toggle-walk">Convertir en walk-in</button>' +
        '<button type="button" class="fl-acc fl-acc-del" data-acc="borrar">Eliminar cita</button>' +
      '</div>';

      els.sheetBody.innerHTML = html;
      els.sheetBody.dataset.cita = c.id;
      mostrarSheet();
    }

    function row(k, v) {
      return '<div class="fl-drow"><span>' + k + '</span><b>' + esc(v) + '</b></div>';
    }

    function abrirNueva() {
      const fecha = iso(ancla);
      const proId = filtroPro !== 'todos' ? filtroPro : (profesionales.find((p) => p.activo) || {}).id;
      els.sheetEyebrow.textContent = fmtFechaLarga(parse(fecha));
      els.sheetTitle.textContent = 'Nueva cita';

      let html = '<div class="fl-form">';
      html += '<label class="fl-lb">Cliente</label><input class="fl-in" name="cliente" placeholder="Nombre y apellido" />';
      html += '<label class="fl-lb">Teléfono</label><input class="fl-in" name="tel" inputmode="tel" placeholder="310 555 0101" />';
      html += '<label class="fl-lb">Profesional</label><select class="fl-in" name="pro">' +
        profesionales.filter((p) => p.activo).map((p) => '<option value="' + p.id + '"' + (p.id === proId ? ' selected' : '') + '>' + esc(p.nombre) + '</option>').join('') + '</select>';
      html += '<label class="fl-lb">Servicio</label><input class="fl-in" name="serv" placeholder="Ej: Semipermanente manos" />';
      html += '<label class="fl-lb">Duración (min)</label><input class="fl-in" name="dur" type="number" min="10" step="5" value="60" />';
      html += '<label class="fl-lb">Precio (COP)</label><input class="fl-in" name="precio" type="number" min="0" step="1000" value="0" />';
      html += '<label class="fl-lb">Fecha</label><input class="fl-in" type="date" name="fecha" value="' + fecha + '" />';
      html += '<label class="fl-lb">Hora</label><input class="fl-in" type="time" name="hora" value="09:00" step="900" />';
      html += '<label class="fl-check"><input type="checkbox" name="walk" /><span>Es walk-in (no bloquea cupos online)</span></label>';
      html += '<button type="button" class="fl-save" data-acc="crear">Guardar cita</button>';
      html += '</div>';

      els.sheetBody.innerHTML = html;
      els.sheetBody.dataset.cita = '';
      mostrarSheet();
    }

    function mostrarSheet() {
      els.sheet.hidden = false;
      els.backdrop.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function cerrarSheet() {
      els.sheet.hidden = true;
      els.backdrop.hidden = true;
      document.body.style.overflow = '';
    }

    // ── pintado general ─────────────────────────────────────────
    function pintar() {
      pintarEncabezado();
      pintarChips();
      const d = delRango();
      pintarStats(d);
      if (vista === 'dia') pintarDia(d);
      else if (vista === 'semana') pintarSemana(d);
      else pintarMes(d);
      enlazar();
    }

    function mover(n) {
      if (vista === 'dia') ancla = addDays(ancla, n);
      else if (vista === 'semana') ancla = addDays(ancla, n * 7);
      else {
        const x = new Date(ancla.getTime());
        x.setUTCDate(1);
        x.setUTCMonth(x.getUTCMonth() + n);
        ancla = x;
      }
      recargar().catch((e) => toast(e.message));
    }

    // ── eventos ─────────────────────────────────────────────────
    function enlazar() {
      qsa('[data-pro]').forEach((b) => b.addEventListener('click', () => { filtroPro = b.dataset.pro; pintar(); }));
      qsa('[data-cita]').forEach((b) => b.addEventListener('click', () => abrirCita(b.dataset.cita)));
      qsa('[data-dia]').forEach((b) => b.addEventListener('click', () => { ancla = parse(b.dataset.dia); vista = 'dia'; sincronizarVistas(); recargar().catch((e) => toast(e.message)); }));

      qsa('[data-estado]').forEach((b) => b.addEventListener('click', () => {
        const c = citas.find((x) => x.id === els.sheetBody.dataset.cita);
        if (!c) return;
        c.estado = b.dataset.estado;
        cerrarSheet();
        pintar();
        persistirCita(c).catch((e) => { toast(e.message); recargar().catch(() => {}); });
      }));

      qsa('[data-acc]').forEach((b) => b.addEventListener('click', () => {
        const a = b.dataset.acc;
        const id = els.sheetBody.dataset.cita;

        if (a === 'borrar') {
          citas = citas.filter((x) => x.id !== id);
          cerrarSheet(); pintar();
          sbBorrar('citas', id).catch((e) => { toast(e.message); recargar().catch(() => {}); });
          return;
        }
        if (a === 'toggle-walk') {
          const c = citas.find((x) => x.id === id);
          if (!c) return;
          c.esWalkIn = !c.esWalkIn;
          cerrarSheet(); pintar();
          persistirCita(c).catch((e) => { toast(e.message); recargar().catch(() => {}); });
          return;
        }
        if (a === 'crear') {
          const q = (n) => els.sheetBody.querySelector('[name="' + n + '"]');
          const nombre = (q('cliente').value || '').trim();
          if (!nombre) { q('cliente').focus(); return; }
          const serv = (q('serv').value || '').trim() || 'Servicio';
          const hm = (q('hora').value || '09:00').split(':');
          const c = {
            id: 'u' + Date.now(), profesionalId: q('pro').value, servicioId: 'manual',
            varianteId: '', varianteNombre: serv,
            clienteNombre: nombre, clienteTelefono: (q('tel').value || '').trim(),
            fecha: q('fecha').value || iso(ancla),
            inicio: Number(hm[0]) * 60 + Number(hm[1]),
            duracion: Math.max(10, Number(q('dur').value) || 60),
            precio: Math.max(0, Number(q('precio').value) || 0), estado: 'confirmada',
            creadaEn: new Date().toISOString(), esWalkIn: q('walk').checked,
          };
          citas.push(c);
          cerrarSheet(); pintar();
          persistirCita(c).catch((e) => { toast(e.message); recargar().catch(() => {}); });
        }
        if (a === 'equipo-nuevo') { abrirEditarEquipo('__nuevo__'); return; }
        if (a === 'equipo-guardar') {
          const q = (n) => els.sheetBody.querySelector('[name="' + n + '"]');
          const pid = b.dataset.id;
          const nombre = (q('eq-nombre').value || '').trim();
          if (!nombre) { q('eq-nombre').focus(); return; }
          const ex = profesionales.find((x) => x.id === pid);
          const p = {
            id: pid, nombre: nombre,
            email: (q('eq-email').value || '').trim() || null,
            color: q('eq-color').value || '#8BA99A',
            foto: (ex && ex.foto) || undefined,
            activo: q('eq-activo').checked,
            es_admin: !!(ex && ex.es_admin),
            horarios: (ex && ex.horarios && ex.horarios.length ? ex.horarios : HORARIO_BASE),
            serviciosIds: (ex && ex.serviciosIds) || [],
            capacidadDiaria: (ex && ex.capacidadDiaria) || 8,
          };
          const i = profesionales.findIndex((x) => x.id === pid);
          if (i >= 0) profesionales[i] = p; else profesionales.push(p);
          persistirProfesional(p).then(() => { abrirEquipo(); }).catch((e) => { toast(e.message); recargar().catch(() => {}); });
        }
      }));
    }

    function sincronizarVistas() {
      qsa('[data-view]').forEach((b) => b.classList.toggle('is-active', b.dataset.view === vista));
    }

    qsa('[data-view]').forEach((b) => b.addEventListener('click', () => { vista = b.dataset.view; sincronizarVistas(); recargar().catch((e) => toast(e.message)); }));
    qs('[data-action="prev"]').addEventListener('click', () => mover(-1));
    qs('[data-action="next"]').addEventListener('click', () => mover(1));
    qs('[data-action="hoy"]').addEventListener('click', () => { ancla = new Date(); recargar().catch((e) => toast(e.message)); });
    qs('[data-action="nueva"]').addEventListener('click', abrirNueva);
    qs('[data-action="cerrar-sheet"]').addEventListener('click', cerrarSheet);
    els.backdrop.addEventListener('click', cerrarSheet);
    qs('[data-action="recargar"]').addEventListener('click', () => { recargar().catch((e) => toast(e.message)); });
    qs('[data-action="equipo"]').addEventListener('click', abrirEquipo);
    qs('[data-action="salir"]').addEventListener('click', () => { salir(); mostrarLogin(); });
    document.querySelector('[data-action="entrar"]').addEventListener('click', intentarEntrar);
    document.querySelector('[data-login]').addEventListener('keydown', (e) => { if (e.key === 'Enter') intentarEntrar(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrarSheet(); });

    (function boot() {
      if (!sbListo()) { mostrarLogin('Falta configurar la conexión (avísale a Felipe)'); return; }
      let t = null; let em = null;
      try { t = localStorage.getItem(SES_TOK); em = localStorage.getItem(SES_EMAIL); } catch (e) {}
      if (t && em) {
        token = t;
        arrancar(em).catch(() => { salir(); mostrarLogin(); });
      } else {
        mostrarLogin();
      }
    })();
  })();
</script>

<style>
  .fl-panel {
    --ink: #141414;
    --base: #F5F0E8;
    --borde: #E4DDD2;
    --cta: #25D366;
    min-height: 100dvh;
    background: #FBF9F6;
    color: var(--ink);
    font-family: 'Inter Variable', 'Inter', system-ui, sans-serif;
    padding: 0 0 90px;
  }

  .fl-topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px; background: #fff; border-bottom: 1px solid var(--borde);
    position: sticky; top: 0; z-index: 20;
  }
  .fl-brand { display: flex; align-items: center; gap: 10px; }
  .fl-dot { width: 12px; height: 12px; border-radius: 50%; display: block; }
  .fl-brand-name { font-weight: 700; font-size: 15px; letter-spacing: -0.2px; }
  .fl-brand-sub { font-size: 11.5px; color: #7A746C; }
  .fl-icon-btn {
    width: 36px; height: 36px; border-radius: 11px; border: 1px solid var(--borde);
    background: #fff; color: var(--ink); display: grid; place-items: center; cursor: pointer;
  }
  .fl-icon-btn:hover { background: var(--base); }

  .fl-nav {
    display: flex; align-items: center; gap: 8px;
    padding: 14px 16px 10px; background: #fff;
  }
  .fl-nav-btn {
    width: 34px; height: 34px; flex: none; border-radius: 10px;
    border: 1px solid var(--borde); background: #fff; color: var(--ink);
    display: grid; place-items: center; cursor: pointer;
  }
  .fl-nav-btn:hover { background: var(--base); }
  .fl-hoy {
    flex: none; padding: 7px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 600;
    border: 1px solid var(--borde); background: #fff; color: var(--ink); cursor: pointer;
  }
  .fl-nav-mid { flex: 1; text-align: center; min-width: 0; }
  .fl-periodo {
    font-size: 15px; font-weight: 700; letter-spacing: -0.3px;
    text-transform: capitalize; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .fl-subperiodo { font-size: 11.5px; color: #7A746C; }

  .fl-views {
    display: flex; gap: 4px; padding: 0 16px 12px; background: #fff;
    border-bottom: 1px solid var(--borde);
  }
  .fl-view-btn {
    padding: 7px 14px; border-radius: 999px; font-size: 13px; font-weight: 600;
    border: 1px solid transparent; background: transparent; color: #6E6862; cursor: pointer;
  }
  .fl-view-btn.is-active { background: var(--ink); color: #fff; }

  .fl-chips {
    display: flex; gap: 8px; padding: 12px 16px; overflow-x: auto;
    scrollbar-width: none; background: #FBF9F6;
  }
  .fl-chips::-webkit-scrollbar { display: none; }
  .fl-chip {
    flex: none; display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 600;
    border: 1px solid var(--borde); background: #fff; color: #4A453F; cursor: pointer; white-space: nowrap;
  }
  .fl-chip i { width: 8px; height: 8px; border-radius: 50%; display: block; }
  .fl-chip em { font-style: normal; font-size: 10px; color: #A0978C; font-weight: 500; }
  .fl-chip span { font-variant-numeric: tabular-nums; color: #948C81; font-weight: 500; }
  .fl-chip.is-active { border-color: var(--ink); color: var(--ink); }

  .fl-stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;
    padding: 0 16px 14px;
  }
  .fl-stat {
    background: #fff; border: 1px solid var(--borde); border-radius: 14px;
    padding: 10px 10px 11px; min-width: 0;
  }
  .fl-stat-l { font-size: 10.5px; color: #8B8377; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
  .fl-stat-v {
    font-size: 19px; font-weight: 700; letter-spacing: -0.6px; margin-top: 3px;
    font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis;
  }
  .fl-stat-s { font-size: 10.5px; color: #9A9186; margin-top: 1px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .fl-body { padding: 0 16px; }

  .fl-dia { display: flex; flex-direction: column; gap: 8px; }

  .fl-card {
    display: flex; align-items: stretch; gap: 11px; width: 100%; text-align: left;
    background: #fff; border: 1px solid var(--borde); border-radius: 16px;
    padding: 12px 13px 12px 0; cursor: pointer; overflow: hidden;
    transition: transform 0.12s ease, border-color 0.12s ease;
  }
  .fl-card:hover { border-color: #C9C0B3; }
  .fl-card:active { transform: scale(0.995); }
  .fl-card-bar { width: 4px; flex: none; background: var(--col); border-radius: 0 4px 4px 0; }
  .fl-card-hora {
    flex: none; width: 46px; padding-left: 11px;
    font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; padding-top: 1px;
  }
  .fl-card-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .fl-card-cliente { font-size: 14px; font-weight: 600; letter-spacing: -0.2px; }
