---
interface Props {
  class?: string;
  width?: number;
  height?: number;
}

const { class: className = '', width = 32, height = 32 } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---

<svg viewBox="0 0 64 64" width={width} height={height} fill="none" aria-hidden="true" class={className}>
  <defs>
    <linearGradient id={`gem-${uid}`} x1="12" y1="8" x2="52" y2="58" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#a99dff" />
      <stop offset="50%" stop-color="#6d5bff" />
      <stop offset="100%" stop-color="#3d2fd0" />
    </linearGradient>
    <linearGradient id={`gem-shine-${uid}`} x1="32" y1="2" x2="32" y2="34" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.6" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
  </defs>
  <path
    d="M32 4 L56 20 L56 44 L32 60 L8 44 L8 20 Z"
    fill={`url(#gem-${uid})`}
  />
  <path d="M32 4 L56 20 L32 34 L8 20 Z" fill={`url(#gem-shine-${uid})`} />
  <path d="M32 34 L56 20 L56 44 L32 60 Z" fill="#000000" fill-opacity="0.14" />
  <path d="M32 34 L8 20 L8 44 L32 60 Z" fill="#ffffff" fill-opacity="0.08" />
  <path d="M32 4 L32 60" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1" />
  <path d="M8 20 L32 34 L56 20" stroke="#ffffff" stroke-opacity="0.5" stroke-width="1" />
  <path d="M8 44 L32 34 L56 44" stroke="#000000" stroke-opacity="0.2" stroke-width="1" />
</svg>
